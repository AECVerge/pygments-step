SCHEMA geometry_primitives;

(* An embedded remark, which (* nests *) per ISO 10303-11 clause 7.1.6. *)

CONSTANT
  origin_name : STRING := 'it''s the origin';   -- doubled quote escape
  flag_mask   : BINARY := %10110;
  encoded     : STRING := "000000E9";
END_CONSTANT;

TYPE length_measure = REAL;
END_TYPE;

TYPE axis_kind = ENUMERATION OF (x_axis, y_axis, z_axis);
END_TYPE;

TYPE positive_length = length_measure;
  WHERE
    positive : SELF > 0.0;
END_TYPE;

ENTITY cartesian_point
  SUBTYPE OF (geometric_representation_item);
    coordinates : LIST [1:3] OF length_measure;
  DERIVE
    dim : INTEGER := HIINDEX(coordinates);
  WHERE
    valid_dim : SIZEOF(coordinates) <= 3;
END_ENTITY;

ENTITY placement
  ABSTRACT SUPERTYPE OF (ONEOF(axis1_placement, axis2_placement))
  SUBTYPE OF (geometric_representation_item);
    location : cartesian_point;
  INVERSE
    used_by : SET [0:?] OF representation FOR items;
END_ENTITY;

FUNCTION dimension_of(item : geometric_representation_item) : INTEGER;
  LOCAL
    n : INTEGER := 0;
  END_LOCAL;

  IF NOT EXISTS(item) THEN
    RETURN (?);
  END_IF;

  REPEAT i := 1 TO 3;
    n := n + 1;
  END_REPEAT;

  CASE n OF
    1 : RETURN (1);
    2 : RETURN (2);
    OTHERWISE : RETURN (3);
  END_CASE;
END_FUNCTION;

RULE unique_names FOR (cartesian_point);
  WHERE
    wr1 : VALUE_UNIQUE(cartesian_point.coordinates);
END_RULE;

END_SCHEMA;  -- tail remark closing the schema
